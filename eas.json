{
  "cli": {
    "version": ">= 22.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.16.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_COMPANY_SLUG": "black-dog-store",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://blackdogstoreperu.com",
        "EXPO_PUBLIC_COMPANY_SLUG": "black-dog-store",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://blackdogstoreperu.com",
        "EXPO_PUBLIC_COMPANY_SLUG": "black-dog-store",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
