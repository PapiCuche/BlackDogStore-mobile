# Black Dog Store — Mobile
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored; this file is not.
#
# EVERY `EXPO_PUBLIC_*` VALUE IS COMPILED INTO THE APP BUNDLE AND IS PUBLIC.
# Never put a secret here: no Django SECRET_KEY, no Stripe secret key, no
# database password, no Apple/Expo/GitHub token.
#
# FAIL-SAFE RULE: a variable left UNSET in a release build resolves to the
# STRICT answer, never the permissive one. See README.md > "Variables de
# entorno".

# Django REST API root, WITHOUT a trailing slash and WITHOUT the /api prefix.
#
# Leave empty during local development: the app derives the host from the Metro
# dev server, which is correct for the iOS Simulator, the Android emulator and a
# physical device on the same network. A RELEASE build with this unset makes no
# guess — it fails loudly on the first request.
#
#   iOS Simulator      http://localhost:8000
#   Android emulator   http://10.0.2.2:8000
#   Physical device    http://<LAN-IP-of-your-Mac>:8000
EXPO_PUBLIC_API_BASE_URL=

# Tenant this build is the storefront for. See BR-002 in docs/BACKEND_REQUIREMENTS.md.
#
# Defaults to `blackdog` ONLY in development. In staging/production an unset
# value is a configuration error — the app will not silently become the pilot
# tenant.
EXPO_PUBLIC_COMPANY_SLUG=blackdog

# Mock data.
#   development  unset -> mocks ON    | =false -> real API
#   staging      unset -> real API    | =true  -> mocks (explicit opt-in)
#   production   mocks are FORBIDDEN — no value enables them.
EXPO_PUBLIC_USE_MOCK_DATA=true

# `staging` marks a release build as non-production. Ignored in development.
# UNSET in a release resolves to `production`, the stricter of the two.
EXPO_PUBLIC_APP_ENV=
