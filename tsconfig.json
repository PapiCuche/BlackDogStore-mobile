{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Caught real bugs during M0: an index into a fixture array is `T | undefined`,
    // not `T`, and pretending otherwise is how a screen crashes on empty data.
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
